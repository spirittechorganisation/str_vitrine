# ── Domaine principal ───────────────────────────────────────────────
INFRA_DOMAIN=spirittechrevolution.com

# ── Tag de l'image Docker Hub ───────────────────────────────────────
TAG=latest

# ── Envoi des e-mails du formulaire de contact (SMTP) ───────────────
# OVH MX Plan : ssl0.ovh.net / 465 / true
# OVH Email Pro : proX.mail.ovh.net / 587 / false (STARTTLS)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@spirittechrevolution.com
SMTP_PASS=
MAIL_FROM="Spirit Tech Revolution <contact@spirittechrevolution.com>"
CONTACT_TO=contact@spirittechrevolution.com
